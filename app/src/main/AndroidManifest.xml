<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required by the user-facing per-app overlay exclusion picker. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".CircleToSearchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CircleToSearch"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        <!-- ONNX Runtime's bundled initializer enables telemetry before app code runs. OCR is
             strictly on-device, so initialization is owned by PaddleOcrEngine instead. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CircleToSearch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CircleToSearchAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Android can retain ROLE_ASSISTANT while dropping VOICE_INTERACTION_SERVICE
          after an app update. In that state SystemUI sends an explicit ACTION_ASSIST
          activity intent to the saved voice-service component. PackageManager keeps
          activity and service resolvers separate, so this alias safely handles that
          degraded path while normal service binding still resolves the service below.
        -->
        <activity
            android:name=".AssistantFallbackActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CircleToSearch.Transparent" />

        <activity-alias
            android:name=".CircleToSearchVoiceService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.ACCESS_VOICE_INTERACTION_SERVICE"
            android:targetActivity=".AssistantFallbackActivity">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".CircleToSearchVoiceService"
            android:exported="true"
            android:process=":voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service_config" />
        </service>

        <service
            android:name=".AssistSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <receiver
            android:name=".AssistantRecoveryReceiver"
            android:exported="false" />

        <service
            android:name=".CircleToSearchRecognitionService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service_config" />
        </service>

        <activity
            android:name=".OverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.CircleToSearch.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <activity
            android:name=".TileTriggerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <service
            android:name=".CircleToSearchTileService"
            android:exported="true"
            android:icon="@drawable/cts1"
            android:label="CTS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.akslabs.circletosearch.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WebViewActivity removed - not implemented -->

    </application>

</manifest>
